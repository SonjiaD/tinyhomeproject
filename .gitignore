# Python virtual environment
venv/
__pycache__/
*.pyc

# VS Code settings
.vscode/

# Environment variables / credentials
.env

# macOS + Windows
.DS_Store
Thumbs.db

# Node + React (frontend)
frontend/node_modules/
frontend/dist/
frontend/.env.local

# Data pipeline — raw scrape outputs and checkpoints (large, intermediate files)
data_pipeline/output/
data_pipeline/spotangel_output/

# Pipeline run history — data/runs/<timestamp>_<script>/manifest.yaml is committed
# (small, durable log of what each run changed); the full geojson snapshots alongside
# each manifest are local-only.
data/runs/*/*.geojson

# Legacy dated archives from before the data/runs/ history mechanism above — local
# machine only, kept ignored so pre-existing rollback copies aren't force-surfaced.
data/polygons/parking_polygons_2*.geojson
data/candidates/candidates_with_features_2*.geojson

# Research CSV exports from export_research_data.py — contain user PII, local only.
# (manifest.yaml under data/runs/ is still committed, documenting each export.)
data/exports/

# Dated OSM feature-layer archives (local history only; the 5 "latest" files in
# data/features/ are committed)
data/features/archive/

# Polygon file removed from frontend/public (now served via /api/polygon_map)
frontend/public/parking_polygons.geojson

# osmnx HTTP response cache (auto-regenerated by generate_parking_polygons.py)
backend/cache/
cache/

# mcps
.playwright-mcp 